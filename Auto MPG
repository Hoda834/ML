import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from ucimlrepo import fetch_ucirepo
cars=fetch_ucirepo(id=9)
x=cars.data.features[["weight"]]
y=cars.data.targets["mpg"]
x_train,x_test,y_train,y_test=train_test_split(x,y,test_size=0.20,random_state=42)
model=LinearRegression()
model.fit(x_train,y_train)
print("intercept:",model.intercept_)
print("weight coefficient:",model.coef_[0])
y_pred=model.predict(x_test)
print(y_pred)
results=pd.DataFrame({"actual":y_test,"prediction":y_pred})
results["residuals"]=results["actual"]-results["prediction"]

print(results.head())
from sklearn.metrics import mean_absolute_error,mean_squared_error,r2_score
r2=r2_score(y_test,y_pred)
mae=mean_absolute_error(y_test,y_pred)
mse=mean_squared_error(y_test,y_pred)
rmse = mse ** 0.5
baseline_value = y_train.mean()
baseline_pred = [baseline_value] * len(y_test)
print("Baseline MAE:", mean_absolute_error(y_test, baseline_pred))
print("Model MAE:", round(mae, 2))
print("Model RMSE:", round(rmse, 2))
print("Model R²:", round(r2, 3))

##fetch_ucirepo(id=9) دیتاست خودروها را می‌گیرد. این همان تابعی است که برای بتن استفاده کردی، با شناسه‌ای دیگر.
features[["weight"]] یک جدول تک‌ستونه برای ورودی مدل می‌سازد. targets["mpg"] ستون جواب‌های ثبت‌شده را برمی‌دارد.
fit() از جفت‌های وزن و MPG ثبت‌شده یک مقدار ثابت و یک ضریب یاد می‌گیرد. چون فقط یک ورودی داریم، model.coef_[0] همان ضریب وزن است.

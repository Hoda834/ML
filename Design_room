import numpy as np
import pandas as pd
rng=np.random.default_rng(10)
area_m2=rng.integers(50,500,40)
room_count=rng.integers(1,10,40)
noise=rng.normal(0,5,40)
design_hours=(20+0.3*area_m2+8*room_count +noise)
df=pd.DataFrame({"area_m2":area_m2,"room_count":room_count,"design_hours":design_hours})
x=df[["area_m2","room_count"]]
y=df["design_hours"]
x_train=x.iloc[:30]
y_train=y.iloc[:30]
x_test=x.iloc[30:]
y_test=y.iloc[30:]
from sklearn.linear_model import LinearRegression
model=LinearRegression()
model.fit(x_train,y_train)
coefficient=model.coef_
intercept=model.intercept_

y_pred=model.predict(x_test)
results=pd.DataFrame({"Actual":y_test.to_numpy(),"predicted":y_pred})
results["Residual"]=results["Actual"]-results["predicted"]
print(results.head())
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
mae=mean_absolute_error(y_test,y_pred)
mse=mean_squared_error(y_test,y_pred)
rmse=np.sqrt(mse)
r2=r2_score(y_test,y_pred)
print(coefficient)
print(intercept)
print("mae:", round(mae, 2))
print("mse:", round(mse, 2))
print("rmse:", round(rmse, 2))
print("r2:", round(r2, 4))
